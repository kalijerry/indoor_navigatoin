{
  "version": 1,
  "runs": {"pr": 3, "nightly": 5},
  "datasets": {
    "ilc-pdr": {"kind": "ilc", "drift": "pdr", "note": "公开商场数据，合成 PDR 漂移（尺度 σ4%、朝向 1.5°/√s）：模拟不开摄像头"},
    "ilc-arkit": {"kind": "ilc", "drift": "arkit", "note": "同上，合成视觉里程计漂移（尺度 σ1%、朝向 0.5°/√s）"},
    "ilc-pdr-sparse": {"kind": "ilc", "drift": "pdr", "build_max": 15, "note": "建图只用随机 15 条 trace：模拟「只走几趟」的稀疏建图"},
    "sim-office": {"kind": "sim", "layout": "office", "drift": "pdr", "note": "合成小场地（tools/bench/sim_small.py，不用外部数据）：约 320 m² 办公室（两间 + 走廊 + 两间），PDR 漂移同 ilc-pdr"},
    "sim-office-phone": {"kind": "sim", "layout": "office", "drift": "phone", "note": "同上，漂移按 2026-11 办公室实测：步长偏短（尺度均值 0.82）、朝向 2°/√s"},
    "sim-pair-phone": {"kind": "sim", "layout": "pair", "drift": "phone", "note": "两间并排、一扇门（约 126 m²，最容易两间认反），实测式漂移"},
    "ilc-imu": {"kind": "ilc", "drift": "imu", "flip_y": true, "note": "同一份建图 / 测试划分，测试会话不写合成位姿：运动来自真实 IMU（手持 Android）走 FusionEngine 计步推算（hpass-eval --motion pdr-imu）。只覆盖手持。y 翻转成我们的地图约定（y 朝下），否则陀螺转向和地图相反"}
  },
  "scenarios": [
    {"id": "public/pdr/track-mag", "dataset": "ilc-pdr", "flags": ["--oracle-start", "--no-ble"],
     "title": "已知起点 · 只地磁 · 无摄像头", "tiers": ["pr", "nightly"], "gate": true},
    {"id": "public/pdr/cold-mag", "dataset": "ilc-pdr", "flags": ["--no-ble", "--no-mag-only-cold-fix"],
     "title": "冷启动 · 只地磁 · 无摄像头（App 冷启动配置档：只靠地磁不报位置；一个位置都不报，只监看、不拦）", "tiers": ["nightly"], "gate": false,
     "target": {"wrong_fix": 0.2, "no_fix_ok": true}},
    {"id": "public/pdr/cold-mag-search", "dataset": "ilc-pdr", "flags": ["--no-ble"],
     "title": "冷启动搜索 · 只地磁 · 无摄像头（照常报位置：量共用的冷启动搜索，和基线比）", "tiers": ["pr", "nightly"], "gate": true},
    {"id": "public/pdr/cold-mag-radio", "dataset": "ilc-pdr", "flags": [],
     "title": "冷启动 · 地磁 + 蓝牙 · 无摄像头", "tiers": ["pr", "nightly"], "gate": true},
    {"id": "public/pdr/cold-wifi", "dataset": "ilc-pdr", "flags": ["--wifi", "--no-ble"],
     "title": "冷启动 · Wi-Fi + 地磁 · 无摄像头（只有 Android 能扫 Wi-Fi）", "tiers": ["pr", "nightly"], "gate": true},
    {"id": "public/pdr-sparse/track-mag", "dataset": "ilc-pdr-sparse", "flags": ["--oracle-start", "--no-ble"],
     "title": "稀疏建图（走几趟）· 已知起点 · 只地磁", "tiers": ["pr", "nightly"], "gate": true},
    {"id": "public/pdr/track-mag-radio", "dataset": "ilc-pdr", "flags": ["--oracle-start"],
     "title": "已知起点 · 地磁 + 蓝牙 · 无摄像头", "tiers": ["nightly"], "gate": true},
    {"id": "public/vio/track-mag", "dataset": "ilc-arkit", "flags": ["--oracle-start", "--no-ble", "--odometry", "vio"],
     "title": "已知起点 · 只地磁 · 视觉里程计", "tiers": ["nightly"], "gate": true},
    {"id": "public/vio/cold-mag", "dataset": "ilc-arkit", "flags": ["--no-ble", "--odometry", "vio", "--no-mag-only-cold-fix"],
     "title": "冷启动 · 只地磁 · 视觉里程计（App 冷启动配置档：只靠地磁不报位置；一个位置都不报，只监看、不拦）", "tiers": ["nightly"], "gate": false,
     "target": {"wrong_fix": 0.2, "no_fix_ok": true}},
    {"id": "public/vio/cold-mag-search", "dataset": "ilc-arkit", "flags": ["--no-ble", "--odometry", "vio"],
     "title": "冷启动搜索 · 只地磁 · 视觉里程计（照常报位置：量共用的冷启动搜索，和基线比）", "tiers": ["nightly"], "gate": true},
    {"id": "public/sim-office/track-mag", "dataset": "sim-office", "flags": ["--oracle-start", "--no-ble", "--rooms"],
     "title": "合成小场地 · 办公室 · 已知起点 · 只地磁 + 房间约束 · PDR 漂移", "tiers": ["pr", "nightly"], "gate": false, "office_metrics": true},
    {"id": "public/sim-office-phone/track-mag", "dataset": "sim-office-phone", "flags": ["--oracle-start", "--no-ble", "--rooms"],
     "title": "合成小场地 · 办公室 · 已知起点 · 只地磁 + 房间约束 · 实测式漂移（步长偏短）", "tiers": ["pr", "nightly"], "gate": false, "office_metrics": true},
    {"id": "public/sim-office-phone/cold-mag", "dataset": "sim-office-phone", "flags": ["--no-ble", "--rooms"],
     "title": "合成小场地 · 办公室 · 冷启动 · 只地磁 + 房间约束 · 实测式漂移", "tiers": ["nightly"], "gate": false, "office_metrics": true},
    {"id": "public/sim-pair-phone/track-mag", "dataset": "sim-pair-phone", "flags": ["--oracle-start", "--no-ble", "--rooms"],
     "title": "合成小场地 · 两间房 · 已知起点 · 只地磁 + 房间约束 · 实测式漂移", "tiers": ["pr", "nightly"], "gate": false, "office_metrics": true},
    {"id": "public/imu/track-mag", "dataset": "ilc-imu", "flags": ["--oracle-start", "--no-ble", "--motion", "pdr-imu"],
     "title": "已知起点 · 只地磁 · 真实 IMU 计步（手持，起步朝向取真值）", "tiers": ["pr", "nightly"], "gate": true, "office_metrics": true},
    {"id": "public/imu/cold-mag-search", "dataset": "ilc-imu", "flags": ["--no-ble", "--motion", "pdr-imu"],
     "title": "冷启动搜索 · 只地磁 · 真实 IMU 计步（照常报位置：量共用的冷启动搜索）", "tiers": ["nightly"], "gate": true, "office_metrics": true},
    {"id": "public/imu/cold-mag-radio", "dataset": "ilc-imu", "flags": ["--motion", "pdr-imu"],
     "title": "冷启动 · 地磁 + 蓝牙 · 真实 IMU 计步", "tiers": ["pr", "nightly"], "gate": true, "office_metrics": true},
    {"id": "public/imu/cold-wifi", "dataset": "ilc-imu", "flags": ["--wifi", "--no-ble", "--motion", "pdr-imu"],
     "title": "冷启动 · Wi-Fi + 地磁 · 真实 IMU 计步（只有 Android 能扫 Wi-Fi）", "tiers": ["nightly"], "gate": true, "office_metrics": true},
    {"id": "public/imu/track-mag-carry", "dataset": "ilc-imu", "flags": ["--oracle-start", "--no-ble", "--motion", "pdr-imu", "--carry-motion"],
     "title": "已知起点 · 只地磁 · 真实 IMU 计步 + 携带无关运动模型（App 默认：携带方式分类、按方式重撒、步长 K 在线标定）", "tiers": ["pr", "nightly"], "gate": true, "office_metrics": true},
    {"id": "public/imu/track-mag-noheading", "dataset": "ilc-imu", "flags": ["--oracle-start", "--no-ble", "--motion", "pdr-imu", "--start-heading", "unknown"],
     "title": "已知起点、起步朝向未知（整圆：口袋 / 包里起步的条件）· 只地磁 · 真实 IMU 计步", "tiers": ["nightly"], "gate": true, "office_metrics": true},
    {"id": "public/imu/track-mag-noheading-carry", "dataset": "ilc-imu", "flags": ["--oracle-start", "--no-ble", "--motion", "pdr-imu", "--start-heading", "unknown", "--carry-motion"],
     "title": "已知起点、起步朝向未知 · 只地磁 · 真实 IMU 计步 + 携带无关运动模型", "tiers": ["nightly"], "gate": true, "office_metrics": true}
  ],
  "private": {
    "note": "自采数据（后台的建图 / 测试会话）。站点名只用哈希代号，公开仓库的报告里不出现任何站点信息",
    "protocols": {
      "walk-once": {"title": "走一遍建图 → 换一天测试（Oriient 的核心指标）", "flags": []},
      "all-builds": {"title": "全部建图会话融合 → 测试", "flags": []},
      "track": {"title": "全部建图会话融合 → 已知起点跟踪（App 实时定位的跟踪配置档 MagneticConfig.tracking）", "flags": ["--oracle-start"]},
      "leave-one-out": {"title": "留一法：其余建图会话建图 → 留下那次的真实 IMU 计步回放（不用专门走测试）",
                        "flags": ["--motion", "pdr-imu", "--carry-motion", "--rooms", "--stationary-freeze", "--no-ble"],
                        "track_flags": ["--oracle-start"], "cold_flags": [], "chain_flags": ["--carry-k", "--vio-k"], "gate": false},
      "office-carry": {"title": "办公室盲测（摄像头关、按携带方式带）· 真实 IMU 计步 · 双机真值",
                       "flags": ["--motion", "pdr-imu", "--carry-motion", "--rooms", "--stationary-freeze"], "track_flags": [], "cold_flags": ["--no-mag-only-cold-fix"]}
    },
    "tiers": ["pr", "nightly"],
    "gate": true
  },
  "tolerance": {
    "median_cm": {"better": "lower", "rel": 0.15, "abs": 30},
    "p90_cm": {"better": "lower", "rel": 0.15, "abs": 60},
    "wrong_fix": {"better": "lower", "rel": 0, "abs": 0.05},
    "coverage": {"better": "higher", "rel": 0, "abs": 0.07},
    "fixed_share": {"better": "higher", "rel": 0, "abs": 0.10}
  },
  "office_ladder": [
    {"name": "可用", "min_room_correct": 0.85, "max_wrong_room_far": 0.03, "max_p50_cm": 250, "max_p90_cm": 500, "max_ttff_m_p50": 30},
    {"name": "目标", "min_room_correct": 0.92, "max_wrong_room_far": 0.02, "max_p50_cm": 150, "max_p90_cm": 300, "max_ttff_m_p50": 20}
  ],
  "ladder": [
    {"name": "可用", "median_cm": 300, "p90_cm": 600, "wrong_fix": 0.20, "coverage": 0.5},
    {"name": "目标", "median_cm": 200, "p90_cm": 400, "wrong_fix": 0.10, "coverage": 0.6},
    {"name": "对标 Oriient", "median_cm": 150, "p90_cm": 300, "wrong_fix": 0.05, "coverage": 0.7}
  ]
}
